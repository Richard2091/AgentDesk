{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schema/message-payloads.json",
  "$defs": {
    "requestExecute": {"type":"object","additionalProperties":false,"required":["tool","contract_version","arguments"],"properties":{"tool":{"type":"string","minLength":1},"contract_version":{"type":"string","minLength":1},"arguments":{"type":"object"},"timeout_ms":{"type":"integer","minimum":1}}},
    "requestStatus": {"type":"object","additionalProperties":false,"required":["target_request_id"],"properties":{"target_request_id":{"type":"string","minLength":1}}},
    "requestCancel": {"type":"object","additionalProperties":false,"required":["reason"],"properties":{"reason":{"type":"string","minLength":1}}},
    "requestUpdate": {"type":"object","additionalProperties":false,"required":["request_id","status","seq"],"properties":{"request_id":{"type":"string","minLength":1},"status":{"enum":["awaiting_confirmation","executing","cancelling"]},"seq":{"type":"integer","minimum":1}}},
    "statusResponse": {"type":"object","additionalProperties":false,"required":["request_id","status","updated_at"],"properties":{"request_id":{"type":"string","minLength":1},"status":{"enum":["requested","awaiting_confirmation","executing","cancelling","completed","failed","timeout","cancelled","rejected","expired"]},"updated_at":{"type":"string","format":"date-time"},"result":{},"error":{"anyOf":[{"type":"object"},{"type":"null"}]}}},
    "progressEvent": {"type":"object","additionalProperties":false,"required":["seq","phase","summary"],"properties":{"seq":{"type":"integer","minimum":1},"phase":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"percent":{"type":"number","minimum":0,"maximum":100}}},
    "resultFinal": {"type":"object","additionalProperties":false,"required":["status","result","error","duration_ms"],"properties":{"status":{"enum":["completed","failed","timeout","cancelled"]},"result":{},"error":{"anyOf":[{"type":"object"},{"type":"null"}]},"duration_ms":{"type":"integer","minimum":0}},"allOf":[{"if":{"properties":{"status":{"const":"completed"}}},"then":{"properties":{"result":{"type":"object"},"error":{"type":"null"}}}},{"if":{"properties":{"status":{"enum":["failed","timeout","cancelled"]}}},"then":{"properties":{"result":{"type":"null"},"error":{"type":"object"}}}}]},
    "cancelAck": {"type":"object","additionalProperties":false,"required":["outcome"],"properties":{"outcome":{"enum":["requested","already_terminal","not_cancellable"]}}},
    "confirmationRequest": {"type":"object","additionalProperties":false,"required":["challenge_id","tool","contract_version","arguments_digest","risk_level","summary","challenge_expires_at"],"properties":{"challenge_id":{"type":"string","minLength":1},"tool":{"type":"string","minLength":1},"contract_version":{"type":"string","minLength":1},"arguments_digest":{"type":"string","minLength":1},"risk_level":{"enum":["low","medium","high"]},"summary":{"type":"string","minLength":1},"challenge_expires_at":{"type":"string","format":"date-time"}}},
    "confirmationSubmit": {"type":"object","additionalProperties":false,"required":["challenge_id","decision","approver_subject"],"properties":{"challenge_id":{"type":"string","minLength":1},"decision":{"enum":["approve","reject"]},"approver_subject":{"type":"string","minLength":1},"confirmation_token":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"decision":{"const":"approve"}}},"then":{"required":["confirmation_token"]}}]},
    "confirmationResult": {"type":"object","additionalProperties":false,"required":["challenge_id","outcome"],"properties":{"challenge_id":{"type":"string","minLength":1},"outcome":{"enum":["approved","rejected","expired","invalid"]},"error":{"type":"object"}}},
    "capabilityQuery": {"type":"object","additionalProperties":false,"maxProperties":0},
    "messageError": {"type":"object","additionalProperties":false,"required":["in_reply_to","error"],"properties":{"in_reply_to":{"type":"string","minLength":1},"error":{"type":"object"}}}
  },
  "type": "object"
}
