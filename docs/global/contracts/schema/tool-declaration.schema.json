{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agentdesk.local/schema/tool-declaration.json",
  "type":"object","additionalProperties":false,
  "required":["name","version","description","input_schema","output_schema","executor","risk_level","permissions","side_effects","default_timeout_ms","max_timeout_ms","cancellation","audit","errors","validation_cases"],
  "properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9.]{2,63}$"},"version":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"input_schema":{"type":"object"},"output_schema":{"type":"object"},"executor":{"type":"string","minLength":1},"risk_level":{"enum":["low","medium","high"]},"permissions":{"type":"object"},"side_effects":{"enum":["none","local_write","external_write"]},"default_timeout_ms":{"type":"integer","minimum":1},"max_timeout_ms":{"type":"integer","minimum":1},"cancellation":{"type":"object"},"audit":{"type":"object"},"errors":{"type":"array","items":{"type":"string"}},"validation_cases":{"type":"array","minItems":1}}
}
